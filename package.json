{
    "name": "q_____c",
    "version": "0.0.0",
    "license": "MIT",
    "files": [
        "dist",
        "src",
        "README.md",
        "tsconfig.json"
    ],
    "type": "module",
    "main": "src/index.ts",
    "publishConfig": {
        "registry": "https://registry.npmjs.org/"
    },
    "scripts": {
        "dev": "rslib build  --config ./build/rslib.config.ts --watch",
        "build": "rslib build --config ./build/rslib.config.ts",
        "editor:dev": "bun run --cwd editor dev",
        "editor:build": "bun run --cwd editor build",
        "extension:dev": "bun run build/extension.bun.ts --watch",
        "extension:build": "bun run build/extension.bun.ts",
        "extension:release": "bun run build/extension.release.bun.ts",
        "build:bundler": "bun run build/build.bun.ts",
        "test": "vitest",
        "build-publish": "npm run build && bun ./build/check-npm-user.ts && npm publish",
        "check-git-user": "bun ./build/check-git-user.ts",
        "web:dev": "qpage --dev ./web ./dist-web",
        "web:build": "qpage ./web ./dist-web",
        "web:preview": "qpage --preview ./web ./dist-web",
        "web:i18n:codex": "codex exec 根据./web/translate.md完成翻译任务",
        "web:publish": "bun run qzrzz-com up ./dist-web ./Q_____c",
        "web:build-publish": "bun run bun web:build && bun run web:publish"
    },
    "dependencies": {},
    "devDependencies": {
        "@rslib/core": "^0.23.2",
        "@types/bun": "latest",
        "@types/node": "^26",
        "@types/pngjs": "6.0.5",
        "chalk": "6.0.0",
        "jpeg-js": "0.4.4",
        "pngjs": "7.0.0",
        "postcss-nesting": "14.0.1",
        "qpage": "link:qpage",
        "qrls": "link:qrls",
        "qzrzz-com": "link:qzrzz-com",
        "tinybench": "6.1.3",
        "vitest": "^4"
    },
    "peerDependencies": {
        "typescript": "^7"
    }
}
